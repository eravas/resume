{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eravas.ca/resume.schema.json",
  "title": "Résumé source",
  "type": "object",
  "required": ["schema_version", "basics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "basics": { "$ref": "#/$defs/basics" },
    "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skillGroup" } },
    "certifications": { "type": "array", "items": { "$ref": "#/$defs/certification" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "experience": { "type": "array", "items": { "$ref": "#/$defs/experience" } },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "outputs": {
      "type": "array",
      "items": { "enum": ["web", "pdf"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$"
    },
    "endDate": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "const": "present" }]
    },
    "url": { "type": "string", "pattern": "^https?://" },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "url": { "$ref": "#/$defs/url" } }
    },

    "selectable": {
      "$comment": "Fields shared by everything a profile can filter.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tags": { "$ref": "#/$defs/tags" },
        "outputs": { "$ref": "#/$defs/outputs" },
        "draft": { "type": "boolean" }
      }
    },

    "highlight": {
      "type": "object",
      "required": ["text"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": { "text": { "type": "string", "minLength": 1 } }
    },
    "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" } },

    "contact": {
      "type": "object",
      "required": ["kind", "value"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": {
        "kind": { "enum": ["email", "phone", "linkedin", "github", "website", "other"] },
        "value": { "type": "string" },
        "url": { "$ref": "#/$defs/url" }
      }
    },

    "basics": {
      "type": "object",
      "required": ["name", "contact"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "headline": { "type": "string" },
        "location": { "type": "string" },
        "work_authorization": { "type": "string" },
        "contact": { "type": "array", "items": { "$ref": "#/$defs/contact" } }
      }
    },

    "education": {
      "type": "object",
      "required": ["id", "institution", "degree", "start"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": {
        "institution": { "type": "string" },
        "location": { "type": "string" },
        "degree": { "type": "string" },
        "field": { "type": "string" },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/endDate" },
        "gpa": { "type": "string" },
        "honors": { "$ref": "#/$defs/highlights" },
        "highlights": { "$ref": "#/$defs/highlights" }
      }
    },

    "skill": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["name"],
          "unevaluatedProperties": false,
          "allOf": [{ "$ref": "#/$defs/selectable" }],
          "properties": { "name": { "type": "string" } }
        }
      ]
    },
    "skillGroup": {
      "type": "object",
      "required": ["id", "label", "items"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": {
        "label": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/skill" }, "minItems": 1 }
      }
    },

    "certification": {
      "type": "object",
      "required": ["id", "name", "date"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "expires": { "$ref": "#/$defs/date" },
        "url": { "$ref": "#/$defs/url" }
      }
    },

    "project": {
      "type": "object",
      "required": ["id", "name", "start"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "role": { "type": "string" },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/endDate" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "highlights": { "$ref": "#/$defs/highlights" }
      }
    },

    "term": {
      "type": "object",
      "required": ["start"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/endDate" }
      }
    },
    "experience": {
      "type": "object",
      "required": ["id", "organization", "title", "terms"],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/selectable" }],
      "properties": {
        "organization": { "type": "string" },
        "location": { "type": "string" },
        "title": { "type": "string" },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/term" }, "minItems": 1 },
        "highlights": { "$ref": "#/$defs/highlights" }
      }
    },

    "sectionName": { "enum": ["education", "skills", "certifications", "projects", "experience"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "extends": { "type": "string" },
        "tags": {
          "oneOf": [{ "const": "*" }, { "$ref": "#/$defs/tags" }]
        },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/sectionName" }, "uniqueItems": true },
        "include": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "order": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
